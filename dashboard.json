{
  "title": "Guestbook Overview",
  "uid": "guestbook-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Redis commands processed/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(redis_commands_processed_total{namespace=\"guestbook\"}[5m])) by (role)",
          "legendFormat": "{{role}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Redis connected clients",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "redis_connected_clients{namespace=\"guestbook\"}",
          "legendFormat": "{{role}} - {{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Guestbook frontend - CPU usage per pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"guestbook\", pod=~\"frontend.*\", container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Guestbook frontend - memory usage per pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"guestbook\", pod=~\"frontend.*\", container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Redis pods - CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"guestbook\", pod=~\"redis-.*\", container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Guestbook pods up",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"guestbook\", phase=\"Running\"})"
        }
      ]
    },
    {
      "id": 7,
      "title": "Error rate (pod restarts/5m, proxy)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "description": "Neither gb-frontend nor Redis expose HTTP status codes, so pod restart rate is used as the error-rate proxy: a crash-looping container is the clearest available signal of the app failing.",
      "targets": [
        {
          "expr": "sum(rate(kube_pod_container_status_restarts_total{namespace=\"guestbook\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
